# pipeline outputs of the example run
general_pipeline/example_data/out/

# regenerated intermediates of the NMD toy test (run_toy.sh recreates them)
NMD/toy_test/root_*/work/

# per-barcode numbers exported for the manuscript figure (1.1 MB, export_panel_data.py recreates it)
NMD/analysis/data/

# raw / heavy sequencing data — never commit these
*.fastq
*.fastq.gz
*.bam
*.bam.bai
*.sam
*.bb
*.bw

# large reference files (see README: hg38_ttaa.bed is 627 MB, hg38.fa ~3 GB)
hg38_ttaa.bed
hg38.fa
*.chrom.sizes

# python bytecode
__pycache__/
*.pyc

# logs and scratch
*.log
*.err
.Rhistory
.RData
.DS_Store
